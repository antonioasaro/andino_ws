{
    "name": "OOMWOO Development Container",
    "privileged": true,
    "remoteUser": "antonio",
    "workspaceFolder": "/home/antonio/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/antonio/${localWorkspaceFolderBasename},type=bind",
    "build": {
        "context": "../src/andino_gz",
        "dockerfile": "../src/andino_gz/docker/dockerfile",
        "args": {
            "USER": "antonio",
            "USERID": "1000"
        }
    },
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "-e", "DISPLAY=${env:DISPLAY}"
        // "--rm"
    ],
    "mounts": [
       "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
       "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
       "source=${localEnv:HOME}${localEnv:USERPROFILE}/.bash_aliases,target=/home/antonio/.bash_aliases,type=bind"

    ]
}
